---
layout: default
---
<p class="intro">{{ site.description }}</p>

<h2 class="section-title">Últimas publicações</h2>
<ol class="post-list">
  {%- for post in collections.posts %}
    {% include "post-row.njk" %}
  {%- endfor %}
</ol>
<p class="more"><a href="/posts.html">Ver todos os posts</a></p>
{%- if favoritos.length %}

<section class="favorites" aria-labelledby="favoritos-titulo">
  <h2 class="favorites-title" id="favoritos-titulo">Últimos favoritos</h2>
  <ul>
    {%- for favorito in favoritos %}
      {% include "favorito-row.njk" %}
    {%- endfor %}
  </ul>
</section>
{%- endif %}
