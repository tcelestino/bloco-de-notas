<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta
      name="description"
      content="{{ summary or site.description }}"
    />
    <meta
      name="keywords"
      content="{{ (tags or site.keywords) | join(', ') }}"
    />
    <link href="{{ site.feedPath }}" type="application/rss+xml" rel="alternate" title="{{ site.title }}">

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="{% if title %}article{% else %}website{% endif %}" />
    <meta property="og:url" content="{{ site.baseUrl }}{{ page.url }}" />
    <meta property="og:title" content="{{ title or site.title }}" />
    <meta property="og:description" content="{{ summary or site.description }}" />
    <meta property="og:image" content="{{ site.url }}assets/images/og-default.png" />
    <meta property="og:site_name" content="{{ site.title }}" />
    <meta property="og:locale" content="pt_BR" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="{{ title or site.title }}" />
    <meta name="twitter:description" content="{{ summary or site.description }}" />
    <meta name="twitter:image" content="{{ site.url }}assets/images/og-default.png" />

    <script>{% include "theme.js" %}</script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:ital,wght@0,400;0,500;1,400&display=swap" />
    <link rel="stylesheet" href="/assets/css/main.css" />
    <link rel="stylesheet" href="/assets/css/post.css" />
    <link rel="stylesheet" href="/assets/css/syntax-highlighting.css" />
    <title>{% if summary %}{{ summary }} - {% endif %}{{ site.title }}</title>

    <script defer src="https://cloud.umami.is/script.js" data-website-id="706bda1c-3aca-440d-b69a-905012ef0900"></script>
  </head>

  <body>
    <a class="skip" href="#conteudo">Ir para o conteúdo</a>

    <header class="site-header wrap">
      {%- set siteTag = "h1" if page.url == "/" else "p" %}
      <{{ siteTag }} class="site-title"><a href="/">Bloco de Notas</a></{{ siteTag }}>
      <nav class="site-nav" aria-label="Principal">
        <ul>
          {%- for item in collections.navLinks.pages %}
            <li><a href="{{ item.url }}"{% if item.url == page.url %} aria-current="page"{% endif %}>{{ item.title }}</a></li>
          {%- endfor %}
          <li hidden>
            <button type="button" id="theme-toggle" aria-pressed="false" aria-label="Modo escuro">
              <svg class="icon icon-moon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
              <svg class="icon icon-sun" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
            </button>
          </li>
        </ul>
      </nav>
    </header>

    <main id="conteudo" class="wrap">
      {{ content | safe }}
    </main>

    <footer class="site-footer wrap">
      <ul>
        {%- for item in collections.navLinks.social %}
          <li><a href="{{ item.url }}" rel="me noopener"{% if item.linkTitle %} title="{{ item.linkTitle }}"{% endif %}>{{ item.title }}</a></li>
        {%- endfor %}
      </ul>
      <p>Por Tiago Celestino. Feito com <a href="https://11ty.dev" rel="noopener">11ty</a>.</p>
    </footer>
  </body>
</html>
